# Jigyasa AI Environment Variables

# The Gemini API Key from Google AI Studio. 
# Vercel serverless functions can read GEMINI_API_KEY or VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Base URL for API requests. Usually relative / for Vercel, or localhost for local server dev.
VITE_API_URL=

# App URL endpoint
APP_URL=http://localhost:3000
